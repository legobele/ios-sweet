-	/* Opt in to SMP: cpus=N (N <= SWEET_SMP_MAX_CPUS; cores 6-7 are the A76s). */
+#if defined(SWEET) || defined(MILANF)
+	/* Opt in to SMP: cpus=N, clamped to the board maximum (milanf: 8 cores). */
