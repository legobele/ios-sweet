From: ios-milanf-port (desk phase, 2026-10-24)
Subject: [PATCH] MILANF: early framebuffer console with milanf geometry

The console draws into the continuous-splash buffer the bootloader
leaves in reserved DRAM, which the display engine keeps scanning out -
so writing pixels works with no display driver, provided the mapping is
Normal-NC. Both mappings are 32MB block descriptors, because with 16K
pages the tables offer L2 = 32MB and nothing between that and an L3
table.

The five sweet values (buffer PA, width, height, stride and the block
base, plus the offset of the buffer in that block) become
BOARD_EARLY_FB_* / BOARD_FB_* in the board headers, so start.s,
arm_vm_init.c and sweet_early.c carry no board constants.

sweet: 0x9c000000, 1080x2400, block == buffer, offset 0.
milanf: 0x85200000 (cont_splash_region, 12MB, from the unit's own DTB),
1080x2460, block 0x84000000, offset 0x1200000. The buffer is not
32MB-aligned and sits inside the RAM map (DRAM starts at 0x80000000),
unlike sweet's, which is below its physBase. The chosen block therefore
also covers RAM below the carveout; the console only ever writes within
the framebuffer extent, so nothing reaches that RAM through the alias.

Table placement is unchanged and still correct for both boards: with
16K pages an L1 entry covers 64GB (ARM_16K_TT_L1_SHIFT 36), so both
blocks live in L1 index 0 and in the L2 page the code already addresses
at bootstrap_pagetables + 2*PGBYTES. (The old comment listed pages 1-4
in the wrong order: page 2 is the KVA L1 table and page 3 is the V=P L2
table the code writes.)

The console banner is board-neutral: XNU EARLY / XNU EARLY PANIC.

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..f7ac4fb 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1825,25 +1825,27 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE)
 #endif
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(MILANF)
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
  * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ * The alias covers the 32MB block that contains the framebuffer, so the
+ * console VA is the alias base plus the framebuffer offset in that block.
  */
-#define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#define EARLY_FB_ALIAS_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
 
 static void
-sweet_early_map_final(void)
+early_fb_map_final(void)
 {
-	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	const vm_map_address_t va = EARLY_FB_ALIAS_VA;
 	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = (tt_entry_t)BOARD_EARLY_FB_BLOCK_PA | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
@@ -2179,18 +2181,18 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	arm_set_user_tbi();
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(MILANF)
 	/* phystokv() must still refer to the bootstrap aperture here. */
-	sweet_early_map_final();
+	early_fb_map_final();
 #endif
 	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
 	ml_enable_monitor();
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(MILANF)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	sweet_early_relocate(SWEET_EARLY_FB_VA);
+	sweet_early_relocate(EARLY_FB_ALIAS_VA + BOARD_EARLY_FB_BLOCK_OFFSET);
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index c70340f..5b04069 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -513,12 +513,12 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(MILANF)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (BOARD_EARLY_FB_PA + (BOARD_FB_HEIGHT - 32) * BOARD_FB_STRIDE)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	mov		x4, #BOARD_FB_STRIDE
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -678,15 +678,19 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(MILANF)
 	/*
 	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
+	 * L2 table. With 16K pages an L1 entry covers 64GB, so the
+	 * framebuffer and all bring-up RAM share L1 index 0; another call to
 	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * create_bootstrap_mapping allocates page 1 (V=P L1), page 2 (KVA
+	 * L1) and page 3 (this V=P L2 table) before it maps anything, so the
+	 * first V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * The block is the 32MB one containing the framebuffer, which is not
+	 * the framebuffer itself unless the carveout is 32MB-aligned.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, BOARD_EARLY_FB_BLOCK_PA
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..d25fdb1 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -7,15 +7,15 @@
  */
 #include <arm64/sweet_early.h>
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(MILANF)
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)BOARD_EARLY_FB_PA;
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
+#define EARLY_WIDTH BOARD_FB_WIDTH
+#define EARLY_HEIGHT BOARD_FB_HEIGHT
+#define EARLY_STRIDE (BOARD_FB_STRIDE / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -99,7 +99,7 @@ sweet_early_mark(unsigned int stage, const char *label)
 		}
 	}
 	__asm__ volatile("dsb sy" ::: "memory");
-	sweet_early_string("SWEET EARLY ");
+	sweet_early_string("XNU EARLY ");
 	if (stage >= 10) {
 		sweet_early_putc((char)('0' + stage / 10));
 	}
@@ -116,7 +116,7 @@ sweet_early_panic(const char *fmt, va_list *args)
 		return;
 	}
 	early_panicking = 1;
-	sweet_early_string("\nSWEET EARLY PANIC: ");
+	sweet_early_string("\nXNU EARLY PANIC: ");
 	va_list copy;
 	va_copy(copy, *args);
 	_doprnt(fmt, &copy, sweet_early_putc, 16);
@@ -140,4 +140,4 @@ sweet_early_disable(void)
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
 }
-#endif /* SWEET */
+#endif /* SWEET || MILANF */
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
index d7a25f2..b56d1fa 100644
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -6,7 +6,7 @@
 #include <stdarg.h>
 #include <stdint.h>
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(MILANF)
 void sweet_early_mark(unsigned int stage, const char *label);
 void sweet_early_putc(char c);
 void sweet_early_panic(const char *fmt, va_list *args);
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index 437adb1..653a470 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1072,7 +1072,7 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
 {
 #pragma clang diagnostic pop
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(MILANF)
 	/* No CPU/thread/debugger state is required for this first panic copy. */
 	sweet_early_panic(panic_format_str, panic_args);
 #endif
diff --git a/pexpert/pexpert/arm64/MILANF.h b/pexpert/pexpert/arm64/MILANF.h
index 7da2695..db5d692 100644
--- a/pexpert/pexpert/arm64/MILANF.h
+++ b/pexpert/pexpert/arm64/MILANF.h
@@ -24,6 +24,25 @@
 
 #define MILANF                    1
 
+/*
+ * Early framebuffer console. The bootloader leaves a live continuous-splash
+ * buffer in reserved DRAM and the display engine keeps scanning it out, so
+ * pixels written there are visible with no display driver in the picture -
+ * which is also why the mapping is Normal-NC and never cached. start.s and
+ * arm_vm_init.c map whole 32MB blocks (16K pages, no L3 tables), so the unit
+ * is the block that contains the buffer, not the buffer itself.
+ *
+ * cont_splash_region@0x85200000, from the unit's own DTB: 12MB, and
+ * 1080x2460 at 4 bytes per pixel fills 10627200 of them. The carveout ends
+ * at 0x85e00000, where dfps_data_region begins. The buffer is only
+ * 2MB-aligned, so the 32MB block that contains it starts at 0x84000000.
+ */
+#define BOARD_EARLY_FB_PA           0x85200000
+#define BOARD_EARLY_FB_BLOCK_PA     0x84000000
+#define BOARD_EARLY_FB_BLOCK_OFFSET 0x1200000
+#define BOARD_FB_WIDTH              1080
+#define BOARD_FB_HEIGHT             2460
+#define BOARD_FB_STRIDE             4320       /* bytes per line, 1080 x 4 */
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
 #define __ARM_VMSA__              8
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..eec3d66 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -25,6 +25,23 @@
  */
 #define SWEET_SMP_MAX_CPUS         8
 
+/*
+ * Early framebuffer console. The bootloader leaves a live continuous-splash
+ * buffer in reserved DRAM and the display engine keeps scanning it out, so
+ * pixels written there are visible with no display driver in the picture -
+ * which is also why the mapping is Normal-NC and never cached. start.s and
+ * arm_vm_init.c map whole 32MB blocks (16K pages, no L3 tables), so the unit
+ * is the block that contains the buffer, not the buffer itself.
+ *
+ * cont_splash_region@0x9c000000 is 32MB-aligned and below physBase, so its
+ * 32MB block contains no RAM at all and block == buffer.
+ */
+#define BOARD_EARLY_FB_PA           0x9c000000
+#define BOARD_EARLY_FB_BLOCK_PA     0x9c000000
+#define BOARD_EARLY_FB_BLOCK_OFFSET 0
+#define BOARD_FB_WIDTH              1080
+#define BOARD_FB_HEIGHT             2400
+#define BOARD_FB_STRIDE             4320       /* bytes per line, 1080 x 4 */
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
 #define __ARM_VMSA__              8
