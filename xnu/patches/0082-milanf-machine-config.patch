+#if defined(MILANF)
+#define BOARD_VTIMER_INTID MILANF_VTIMER_INTID
+#define BOARD_IPI_SGI      MILANF_IPI_SGI
+#else
+#define BOARD_VTIMER_INTID SWEET_VTIMER_INTID
+#define BOARD_IPI_SGI      SWEET_IPI_SGI
+#endif
 	/*
 	 * Real hardware with two security states: Group 0 is TrustZone's and
 	 * non-secure writes to it are ignored. Everything we own is Group 1 NS
@@ -175,7 +186,7 @@
